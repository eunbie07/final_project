                className="w-3 h-3 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 focus:ring-1"
              />
              <span className="group-hover:text-blue-700 transition-colors duration-200">
                창문 표시
              </span>
            </label>
          </div>
        </div>
      </div>

              {detectedWindows.length > 0 && (
